            when p.age between 40 and 64 then 'Adult'
            else 'Senior'
        end                                             as age_group,
        case
            when p.age >= 65 then true
            else false
        end                                             as is_senior,
        case
            when p.age < 18 then true
            else false
        end                                             as is_pediatric
    from patients p
    left join states s on p.state_code = s.state_code
)

